# EditDNA configuration — copy to `.env` and fill in what you need.
# Everything is optional: with no LLM key configured, EditDNA runs fully
# deterministic (heuristic) planning.

# ---- LLM provider -------------------------------------------------------
# gemini (default, free tier) | openai | anthropic | ollama | openai_compatible
EDITDNA_LLM_PROVIDER=gemini

# API key for the chosen provider (Gemini: https://aistudio.google.com/apikey)
EDITDNA_API_KEY=

# Optional explicit model override. Defaults per provider:
#   gemini:            gemini/gemini-2.5-flash
#   openai:            openai/gpt-4o-mini
#   anthropic:         anthropic/claude-3-5-haiku-latest
#   ollama:            (uses EDITDNA_OLLAMA_MODEL)
EDITDNA_MODEL=

# Custom OpenAI-compatible endpoint (OpenRouter, vLLM, LM Studio, ...)
EDITDNA_OPENAI_BASE_URL=

# ---- Ollama (fully local / offline) --------------------------------------
EDITDNA_OLLAMA_BASE_URL=http://localhost:11434
EDITDNA_OLLAMA_MODEL=llama3.1

# ---- OCR (reference-video caption/text detection) ------------------------
# Comma-separated languages supported by EasyOCR, e.g. en,es,de
EDITDNA_OCR_LANGUAGES=en
# Minimum confidence 0..1 for a text detection to be kept
EDITDNA_OCR_MIN_CONFIDENCE=0.5

# ---- Storage -------------------------------------------------------------
# Directory for saved style templates. Defaults to ./templates if it exists,
# otherwise ~/.editdna/templates
EDITDNA_TEMPLATES_DIR=
